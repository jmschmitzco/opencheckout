# ---------------------------------------------------------------------------
# OpenCheckout configuration
#
# Copy this file to .env and fill it in. Never commit .env.
# Payment gateway API keys do NOT belong here: each merchant stores its own,
# encrypted, through the dashboard. The only exception is the single-merchant
# self-hosted setup described in docs/SELF_HOSTING.md.
# ---------------------------------------------------------------------------

# Required. At least 32 characters. Encrypts gateway credentials and webhook
# secrets at rest, and signs session cookies. Changing it makes every stored
# credential unreadable, so generate it once and keep it safe.
APP_SECRET=

# Required in production. PostgreSQL connection string.
DATABASE_URL=postgres://opencheckout:opencheckout@localhost:5432/opencheckout

# Public origin of this installation, with no trailing slash. Every checkout
# URL, embed script and webhook callback is built from it, so it has to be the
# address customers actually reach.
BASE_URL=http://localhost:3000

PORT=3000
NODE_ENV=development

# Optional. Separate origin for the merchant dashboard (app.example.com).
# Empty keeps the dashboard on BASE_URL.
DASHBOARD_BASE_URL=

# Optional. Comma separated list of origins allowed to embed the checkout in an
# iframe, on top of each merchant's own allowed origins. Use it for local
# development only; in production the merchant declares its origins.
EMBED_EXTRA_ORIGINS=

# How long a checkout session stays open, in minutes. After that the link stops
# working and the cart counts as abandoned.
SESSION_TTL_MINUTES=60
